    {
      "check": "p2pk.malformed",
      "software": "cdk-mintd",
      "text": "CDK keeps the first copy of a duplicated spending-condition tag instead of rejecting the proof as NUT-11 requires. The fix was merged upstream on 16 Nov 2026; mints pass once they run a CDK release that includes it.",
      "url": "https://github.com/cashubtc/cdk/pull/2888",
      "link_text": "CDK PR #2888",
      "label": "CDK fix merged, upgrade when released"
    },
    {
      "check": "p2pk.malformed",
      "software": "nutshell",
      "below": "0.21.0",
      "text": "Nutshell versions before 0.21.0 accept duplicated spending-condition tags. Fixed in Nutshell 0.21.0; upgrading the mint fixes it.",
      "url": "https://github.com/cashubtc/nutshell/pull/1008",
      "link_text": "Nutshell PR #1008",
      "label": "fixed in Nutshell 0.21.0: upgrade"
    },
    {
      "check": "htlc.refund",
      "software": "cdk-mintd",
      "text": "CDK 0.18.x reads a witness without a preimage as a P2PK witness, so it refuses the HTLC refund path (the refund key's signature alone, after the locktime). Fixed on CDK main in #2641 (October 2026), not yet in a release; a backport is requested in cdk#2980. Found by Mintprobe.",
      "url": "https://github.com/cashubtc/cdk/issues/2980",
      "link_text": "CDK issue #2980",
      "label": "fixed on CDK main, upgrade when released"
    },
    {
      "check": "ws.subscribe",
      "software": "cdk-mintd",
      "text": "CDK doesn't send the first notification for a proof it has never seen, although NUT-17 requires the current state (UNSPENT) first. A fix is in review in cdk#2983. Found by Mintprobe.",
      "url": "https://github.com/cashubtc/cdk/pull/2983",
      "link_text": "CDK PR #2983",
      "label": "CDK fix in review"
    }
  ],
